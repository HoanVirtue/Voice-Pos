{
  "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "http://localhost:8080", "http://localhost:50792" ],
  "ConnectionStrings": {
    "BanHangConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "BanHang",
    "Audience": "BanHang",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "FileStorage": {
    "RootPath": "./data/files",
    "DownloadRoute": "/api/v1/Files/download"
  },
  "Blaze": {
    "Token": ""
  },
  "Seed": {
    "AdminUsername": "admin",
    "BoUsername": "bo",
    "MeUsername": "me"
  },
  "UseHttpsRedirection": false,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
