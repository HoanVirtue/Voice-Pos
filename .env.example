# Sao chép thành .env rồi sửa giá trị. KHÔNG commit .env. Giá trị dưới đây chỉ là ví dụ cho máy dev.
# File này dùng chung cho `docker compose` và `dotnet run` (backend tự nạp .env ở thư mục gốc repo).

# --- MySQL (docker compose) ---
MYSQL_ROOT_PASSWORD=doi-mat-khau-root
MYSQL_DATABASE=banhang
MYSQL_USER=banhang
MYSQL_PASSWORD=doi-mat-khau-db
MYSQL_PORT=3306

# --- Chạy API local bằng `dotnet run` (trỏ vào MySQL của compose hoặc MySQL cài sẵn) ---
# Phải khớp MYSQL_USER / MYSQL_PASSWORD ở trên. Trong compose, API tự dùng host "db" nên biến này chỉ cho chạy local.
ConnectionStrings__BanHangConnection=Server=localhost;Port=3306;Database=banhang;User=banhang;Password=doi-mat-khau-db;CharSet=utf8mb4

# --- API ---
# Cổng publish của container api (dotnet run local dùng http://localhost:5299)
API_PORT=8080
# Khóa ký JWT, tối thiểu 32 ký tự. Sinh khóa thật: openssl rand -base64 48
Jwt__Secret=doi-khoa-bi-mat-jwt-toi-thieu-32-ky-tu-0123456789
# Nguồn được phép gọi API từ trình duyệt (app web). Thêm AllowedOrigins__1, __2... nếu cần.
AllowedOrigins__0=http://localhost:3000

# --- Nhận dạng giọng nói (chỉ ở server; app lấy qua GET /api/v1/Voice/stt-token) ---
Blaze__Token=

# --- Mật khẩu tài khoản seed lần chạy đầu (để trống = bỏ qua tài khoản đó). ĐỔI sau lần đăng nhập đầu. ---
Seed__AdminPassword=doi-mat-khau-admin
Seed__BoPassword=doi-mat-khau-bo
Seed__MePassword=doi-mat-khau-me
